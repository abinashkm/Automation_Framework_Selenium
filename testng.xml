<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="SwagLabsParallelSuite" parallel="classes" thread-count="3" verbose="1">
    <parameter name="browser" value="chrome"/>
    <parameter name="baseUrl" value="https://www.saucedemo.com/"/>

    <test name="Swag Labs Regression">
        <classes>
            <class name="tests.LoginTest"/>
            <class name="tests.InventoryTest"/>
            <class name="tests.NegativeFlowTest"/>
            <class name="tests.CheckoutAndMenuTest"/>
        </classes>
    </test>
</suite>
